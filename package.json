{
  "name": "manual-explorer-reveal",
  "displayName": "Manual Explorer Reveal",
  "description": "Disables automatic Explorer reveal and adds a manual target button for the active file.",
  "version": "1.0.0",
  "publisher": "rhapsodic",
  "author": {
    "name": "rhapsodic.dev",
    "email": "rhapsodic.dev@gmail.com",
    "url": "https://github.com/rhapsodic-dev"
  },
  "contributors": [
    {
      "name": "Svyatoslav Fyodorov",
      "email": "intelrug@gmail.com",
      "url": "https://github.com/intelrug"
    },
    {
      "name": "TrenLok",
      "email": "trenlok.dev@gmail.com",
      "url": "https://github.com/trenlok"
    }
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "explorer",
    "reveal",
    "autoReveal"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:manualExplorerReveal.revealActiveFile"
  ],
  "icon": "res/icon.png",
  "main": "./dist/index.mjs",
  "contributes": {
    "commands": [
      {
        "command": "manualExplorerReveal.revealActiveFile",
        "title": "Reveal Active File in Explorer",
        "category": "Explorer",
        "icon": "$(target)"
      },
      {
        "command": "manualExplorerReveal.restoreAutoReveal",
        "title": "Restore Explorer Auto Reveal",
        "category": "Explorer"
      }
    ],
    "configurationDefaults": {
      "explorer.autoReveal": false
    },
    "menus": {
      "commandPalette": [
        {
          "command": "manualExplorerReveal.revealActiveFile"
        },
        {
          "command": "manualExplorerReveal.restoreAutoReveal"
        }
      ],
      "editor/title": [
        {
          "command": "manualExplorerReveal.revealActiveFile",
          "group": "navigation@100",
          "when": "resourceScheme == file"
        }
      ],
      "view/title": [
        {
          "command": "manualExplorerReveal.revealActiveFile",
          "group": "navigation@100",
          "when": "view == workbench.explorer.fileView"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p . --noEmit",
    "check": "pnpm run typecheck && pnpm run build",
    "package": "vsce package --allow-missing-repository",
    "release": "bumpp",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "vscode:prepublish": "pnpm run check",
    "prepare": "pnpm run hooks:install",
    "hooks:install": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@rhapsodic/eslint-config": "^1.0.5",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.144.0",
    "@vscode/vsce": "^3.9.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.4",
    "typescript": "6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint",
    "commit-msg": "pnpm exec commitlint --edit"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
